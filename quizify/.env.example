# ===== Groq API =====
# Get a FREE key at https://console.groq.com (no billing required)
# Free tier: 14,400 requests/day -- very generous for this project
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ===== JWT Auth =====
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_this_to_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ===== Database =====
DATABASE_URL=sqlite:///./database/quizify.db

# ===== Vector store =====
CHROMA_PERSIST_DIR=./vectorstore/chroma_data

# ===== FastAPI =====
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000

# ===== App =====
ENVIRONMENT=development
